rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Los ids de chat y de lista son secretos e imposibles de adivinar; no se pueden listar las colecciones.
    match /chats/{chatId}/messages/{msgId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['r', 't', 'at'])
                    && request.resource.data.r in ['s', 'g']
                    && request.resource.data.t is string
                    && request.resource.data.t.size() > 0
                    && request.resource.data.t.size() <= 500
                    && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    match /wishlists/{wid} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['items', 'at'])
                            && request.resource.data.items is list
                            && request.resource.data.items.size() <= 30
                            && request.resource.data.at == request.time;
      allow delete: if false;
    }
  }
}
