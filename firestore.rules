rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Todos los ids (enlaces, chats, listas) son secretos e imposibles de adivinar; no se pueden listar las colecciones.

    // Asignación de cada participante. Solo quien la creó (el organizador, con su sesión anónima) puede borrarla = revocar el enlace.
    match /links/{tok} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.keys().hasOnly(['owner', 'f', 't', 'g', 'b', 'd', 'c1', 'c2', 'w', 'w2'])
                    && request.resource.data.f is string && request.resource.data.f.size() <= 60
                    && request.resource.data.t is string && request.resource.data.t.size() <= 60
                    && request.resource.data.g is string && request.resource.data.g.size() <= 80
                    && request.resource.data.b is string && request.resource.data.b.size() <= 20
                    && request.resource.data.d is string && request.resource.data.d.size() <= 10;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == resource.data.owner;
    }

    match /chats/{chatId}/messages/{msgId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['r', 't', 'at'])
                    && request.resource.data.r in ['s', 'g']
                    && request.resource.data.t is string
                    && request.resource.data.t.size() > 0
                    && request.resource.data.t.size() <= 500
                    && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    match /wishlists/{wid} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['items', 'at'])
                            && request.resource.data.items is list
                            && request.resource.data.items.size() <= 30
                            && request.resource.data.at == request.time;
      allow delete: if false;
    }
  }
}
